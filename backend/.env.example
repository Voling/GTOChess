# Copy to .env and adjust. Every setting is optional; the defaults shown are used
# when the variable is absent.

# --- engine -----------------------------------------------------------------
# Path to the Stockfish binary. Leave unset to resolve /opt/stockfish then
# vendor/stockfish/<platform>. A Stockfish on PATH is never used.
# GTOCHESS_ENGINE_PATH=
GTOCHESS_ENGINE_THREADS=1
GTOCHESS_ENGINE_HASH_MB=128

# Depth for the multi-PV report that produces the choice set.
GTOCHESS_ANALYSIS_DEPTH=20
# Depth for ablation probes, which run once per candidate element.
GTOCHESS_ABLATION_DEPTH=12
# Candidate moves requested per position.
GTOCHESS_MULTIPV=4

# --- thresholds -------------------------------------------------------------
# Gap to the second best move above which a position has only one real answer.
GTOCHESS_ONLY_MOVE_THRESHOLD_CP=300
# Moves within this much of the best are treated as genuine alternatives.
GTOCHESS_PLAYABLE_BAND_CP=30
# Ablation deltas below this are search noise and never reach the dossier.
GTOCHESS_SENSITIVITY_FLOOR_CP=40
GTOCHESS_SENSITIVITY_TOP_N=5

# --- position selection -----------------------------------------------------
# Plies past which a position is middlegame rather than opening.
GTOCHESS_SELECTION_MAX_PLY=24
# Games through a position before it is analysed unconditionally.
GTOCHESS_SELECTION_MIN_GAMES=3
# Games through a sparse position where the player varied their move.
GTOCHESS_SELECTION_MIN_DIVERGENCE_GAMES=2
# Hard cap on positions sent to the engine per player.
GTOCHESS_SELECTION_BUDGET=400
# Divergence positions kept per ply at the frontier.
GTOCHESS_SELECTION_FRONTIER_SAMPLE=2

# --- profile ----------------------------------------------------------------
# Observations a trait needs before it is reported rather than omitted.
GTOCHESS_PROFILE_MIN_SAMPLE=20
# Positions cited as evidence per trait.
GTOCHESS_PROFILE_EVIDENCE_LIMIT=5
# Evaluation loss that counts as a blunder for the tilt measurement.
GTOCHESS_BLUNDER_CP=100
# Evaluation above which a position counts as winning, for conversion.
GTOCHESS_WINNING_CP=200
# Evaluation below which a position counts as losing, for resilience.
GTOCHESS_LOSING_CP=-200

# --- flaws ------------------------------------------------------------------
# Times a mistake must recur before it enters the flaw list.
GTOCHESS_FLAW_MIN_OCCURRENCES=2
# Mean evaluation loss below which a repeated move is not worth listing.
GTOCHESS_FLAW_MIN_MEAN_LOSS_CP=50
GTOCHESS_FLAW_LIMIT=25

# --- opening strength -------------------------------------------------------
# Games in an opening before its result is scored at all.
GTOCHESS_OPENING_EDGE_MIN_GAMES=10
# Strength of the pull toward the population score, in games.
GTOCHESS_OPENING_EDGE_PRIOR_GAMES=30

# --- lichess ----------------------------------------------------------------
GTOCHESS_LICHESS_BASE_URL=https://lichess.org
# OAuth token. Raises the export limit from 20 to 60 games per second on the
# authenticated account's own games.
# GTOCHESS_LICHESS_TOKEN=
GTOCHESS_LICHESS_TIMEOUT_S=60
GTOCHESS_LICHESS_MAX_RETRIES=4
# Seconds to wait after a 429 when no Retry-After header is returned.
GTOCHESS_LICHESS_BACKOFF_S=60

# --- ingest -----------------------------------------------------------------
GTOCHESS_INGEST_RATED_ONLY=true
# Comma separated speeds to import. Empty imports every speed.
GTOCHESS_INGEST_PERF_TYPES=bullet,blitz,rapid,classical
GTOCHESS_INGEST_MAX_GAMES=2000
# Plies replayed per game when building the repertoire.
GTOCHESS_INGEST_MAX_PLY=24

# --- opening families -------------------------------------------------------
# Plies scanned per game when measuring how forcing an opening runs.
GTOCHESS_FAMILY_WINDOW_PLY=16
# Games an opening needs before it is reported at all.
GTOCHESS_FAMILY_MIN_GAMES=4
# Prior weight that pulls a sparse opening toward the player's own average.
GTOCHESS_FAMILY_PRIOR_GAMES=12
# Openings that get a colour of their own in the graph. The rest stay neutral.
GTOCHESS_FAMILY_SLOTS=3

# --- explanations -----------------------------------------------------------
# auto uses the model when credentials exist, deterministic never calls out.
GTOCHESS_LLM_PROVIDER=auto
# Sonnet 5 at $3/$15 per million against Opus 5 at $5/$25, same 1M context and
# the same structured output and effort controls. claude-haiku-4-5 is cheaper
# again at $1/$5, with 200K context and noticeably weaker reasoning over the
# engine lines.
GTOCHESS_LLM_MODEL=claude-sonnet-5
# Reasoning depth per request: low, medium, high, xhigh, max.
GTOCHESS_LLM_EFFORT=medium
GTOCHESS_LLM_MAX_TOKENS=1500
GTOCHESS_LLM_TIMEOUT_S=60
# Explanations held in memory before the oldest is dropped.
GTOCHESS_LLM_CACHE_ENTRIES=512
# Search depth for the report an explanation is built from.
GTOCHESS_EXPLAIN_DEPTH=18
# Key for the explanation model. ANTHROPIC_API_KEY is read when this is unset.
# GTOCHESS_ANTHROPIC_API_KEY=

# --- move annotations --------------------------------------------------------
# Search depth behind the ? and ?! marks on the graph.
GTOCHESS_ANNOTATION_DEPTH=16
# Centipawns given up before a move is called dubious, a mistake, a blunder.
# Well above the middlegame convention: sound opening moves differ by tens of
# centipawns, and a lower floor marks a whole repertoire as flawed.
GTOCHESS_ANNOTATION_DUBIOUS_CP=90
GTOCHESS_ANNOTATION_MISTAKE_CP=160
GTOCHESS_ANNOTATION_BLUNDER_CP=300
# Games a move needs before it is worth an engine search.
GTOCHESS_ANNOTATION_MIN_GAMES=2
# Positions searched per run, busiest first.
GTOCHESS_ANNOTATION_BUDGET=400

# --- jobs --------------------------------------------------------------------
# Seconds a finished job result stays readable.
GTOCHESS_JOB_RESULT_TTL_S=86400
# Games between progress updates on an import.
GTOCHESS_JOB_REPORT_EVERY=250
# Built graphs held in memory. A large import makes each one costly.
GTOCHESS_GRAPH_CACHE_ENTRIES=8

# --- lichess sign in ---------------------------------------------------------
# Any string identifies a public OAuth client; lichess needs no registration.
GTOCHESS_LICHESS_CLIENT_ID=gtochess.local
GTOCHESS_LICHESS_REDIRECT_URI=http://localhost:5173/auth/lichess/callback

# --- job webhooks ------------------------------------------------------------
# Posted to when an import or annotation run finishes, so a caller can await a
# job instead of polling. Unset disables delivery.
# GTOCHESS_JOB_WEBHOOK_URL=
# Signs the body as X-GTOChess-Signature: sha256=<hmac of "<timestamp>.<body>">.
# GTOCHESS_JOB_WEBHOOK_SECRET=
GTOCHESS_JOB_WEBHOOK_TIMEOUT_S=10

# --- engine probes -----------------------------------------------------------
# Lets the model ask Stockfish about a line instead of working it out itself.
GTOCHESS_LLM_PROBE_ENABLED=true
GTOCHESS_LLM_PROBE_DEPTH=14
# Ceiling on engine questions per explanation.
GTOCHESS_LLM_PROBE_MAX_CALLS=6
# Walks held in memory. Only depth and colour change one.
GTOCHESS_WALK_CACHE_ENTRIES=4

# --- service ----------------------------------------------------------------
GTOCHESS_USER_AGENT=GTOChess/0.1
# Version segment in cache keys. Bumping it rotates every cached explanation.
GTOCHESS_PIPELINE_VERSION=v2
GTOCHESS_API_HOST=0.0.0.0
GTOCHESS_API_PORT=8000
# Directory holding <username>.games.jsonl imports.
GTOCHESS_DATA_DIR=data

GTOCHESS_REDIS_URL=redis://localhost:6379/0

# Where every store reads and writes. Unset, that is GTOCHESS_DATA_DIR on
# whatever filesystem is mounted there: local disk, NFS, EFS. Set, the same
# records become objects in this bucket and no filesystem is shared between the
# API and the workers.
# GTOCHESS_S3_BUCKET=gtochess-prod-data
# GTOCHESS_S3_PREFIX=

# --- access ------------------------------------------------------------------
# The endpoints that call a model are closed unless a verified account asks.
# Turning this off locally lets the app run without a user pool; never off in
# a deployment, or anyone who finds the URL spends your Anthropic budget.
GTOCHESS_AUTH_REQUIRED=false
# GTOCHESS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# GTOCHESS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# GTOCHESS_COGNITO_REGION=us-east-1
# Analyses one account may start per day. Signing in says who is spending, this
# says how much. Each one is a tool loop against Opus, so the ceiling is the
# difference between a few dollars a month and a few hundred.
GTOCHESS_ANALYSIS_DAILY_LIMIT=10

# --- deployment --------------------------------------------------------------
# What terraform supplies in the task definition. Values come from the stack
# outputs, so these are shapes rather than settings to copy.
#
#   GTOCHESS_DATA_DIR=/data
#   GTOCHESS_ENGINE_PATH=/opt/stockfish/stockfish
#   GTOCHESS_REDIS_URL=redis://<elasticache-primary-endpoint>:6379/0
#   GTOCHESS_COGNITO_USER_POOL_ID=<terraform output cognito_user_pool_id>
#   GTOCHESS_COGNITO_CLIENT_ID=<terraform output cognito_client_id>
#   GTOCHESS_AUTH_REQUIRED=true
#   ANTHROPIC_API_KEY=<secretsmanager gtochess-<env>/anthropic-api-key>
#
# The Anthropic key arrives as an ECS secret rather than plain environment, so it
# is not readable from a task description.
