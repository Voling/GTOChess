# Environments
.venv/
venv/
.env

# Build
node_modules/
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]

# Engine binaries are build inputs fetched from engine.lock.json, never
# committed. The lockfile is the reproducible artifact; the binary is not.
vendor/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data
*.pgn
*.pgn.zst
data/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
# .terraform.lock.hcl is committed on purpose, so CI resolves the same provider
# versions a local plan did.
# infra/terraform/terraform.tfvars is committed on purpose. It holds a domain,
# a zone id and three switches, none of which is a secret, and hiding them costs
# the ability to see what a plan is about to do.
*.auto.tfvars
infra/terraform/backend.tf
tfplan
