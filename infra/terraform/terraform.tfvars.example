region      = "us-east-1"
project     = "fiftymoves"
environment = "prod"

# Leave both empty to serve on the CloudFront domain. Set them together: a
# certificate cannot be validated without the zone that answers for the name.
domain_name    = ""
hosted_zone_id = ""

# Diversify. One instance type is one spot pool, and the first pool to tighten
# takes the whole fleet with it.
worker_instance_types = ["c7a.2xlarge", "c7i.2xlarge", "c6a.2xlarge"]
worker_min_size       = 0
worker_max_size       = 4

db_instance_class = "db.t4g.medium"
redis_node_type   = "cache.t4g.micro"

# Set by CI to the image it just pushed.
image_tag = "latest"
